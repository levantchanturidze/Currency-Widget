PORT=3001
NODE_ENV=development

# TBC Bank API key — register at https://api.tbcbank.ge
# Leave blank to fall back to web scraping
TBC_API_KEY=

# Cache TTL in seconds (default 90)
CACHE_TTL=90

# Per-source request timeout in milliseconds (default 5000)
REQUEST_TIMEOUT_MS=5000

# Retry attempts per source on failure (default 2)
RETRY_ATTEMPTS=2
